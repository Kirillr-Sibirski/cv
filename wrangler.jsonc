{
  "name": "cv",
  "compatibility_date": "2026-08-23",
  // The site is a Next static export, so this Worker serves `out/` directly
  // and runs no script of its own.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "krlberg.dev", "custom_domain": true },
    { "pattern": "www.krlberg.dev", "custom_domain": true }
  ],
  // The resume should be reachable at one canonical URL, not also at
  // workers.dev and per-version preview hostnames.
  "workers_dev": false,
  "preview_urls": false
}
